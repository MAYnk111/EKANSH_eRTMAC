rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Structure: /documents/{userId}/{wellId}/{fileName}
    match /documents/{userId}/{wellId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                    && (request.auth.uid == userId || request.auth.token.role == 'Operations Manager')
                    && request.resource.size < 50 * 1024 * 1024 // 50MB max limit
                    && (
                      request.resource.contentType.matches('application/pdf') ||
                      request.resource.contentType.matches('application/vnd.ms-excel') ||
                      request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*') ||
                      request.resource.contentType.matches('text/csv') ||
                      request.resource.contentType.matches('text/plain') ||
                      request.resource.contentType.matches('image/.*')
                    );
    }
  }
}
